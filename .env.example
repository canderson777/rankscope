# -----------------------------------------------------------------------------
# Rankscope — local environment
# Copy this file to .env.local and fill in your key. .env.local is gitignored.
# -----------------------------------------------------------------------------

# Required for live data. Get one at:
#   https://app.dataforseo.com/api-access
# Use the longer "Base64" credentials DataForSEO emails you, or paste your
# raw "login:password" — the server handles either.
DATAFORSEO_API_KEY=

# Which market to query. Affects volume, difficulty and SERP composition.
DATAFORSEO_LOCATION=United States
DATAFORSEO_LANGUAGE=English

# How long to reuse cached API responses, in hours. SEO metrics update slowly;
# a long TTL is the single biggest thing keeping your bill down during dev.
CACHE_TTL_HOURS=24

# Hard stop if a single server session spends more than this many dollars.
SPEND_CAP_USD=5

# Port for the local API server (Vite proxies /api here).
API_PORT=8787

# -----------------------------------------------------------------------------
# PageSpeed Insights (Site Audit) — FREE, no DataForSEO credits used
# -----------------------------------------------------------------------------
# Works with no key at all. A key only raises the rate limit (to 25k/day).
# Get one free: https://console.cloud.google.com -> enable "PageSpeed Insights API"
PAGESPEED_API_KEY=

# -----------------------------------------------------------------------------
# Google Search Console — FREE, first-party impressions/clicks/position
# -----------------------------------------------------------------------------
# Needs a Google Cloud OAuth client with the Search Console API enabled:
#   1. https://console.cloud.google.com -> pick/create a project
#   2. Enable "Search Console API" in that project
#   3. APIs & Services -> OAuth consent screen (External, add your address as a
#      test user) -> Credentials -> Create OAuth client (Web application)
#   4. Authorized redirect URI must match GSC_REDIRECT_URI below (localhost flow)
#   5. Paste the client id and secret here, then restart the server
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# Local callback that Google redirects to after consent. Keep this in sync with
# the Authorized redirect URI in Google Cloud.
GSC_REDIRECT_URI=http://localhost:8788/api/gsc/callback
# Optional: pin the property when auto-matching a domain to your Search Console
# sites fails (e.g. "sc-domain:example.com" or "https://www.example.com/").
# Leave blank to auto-match by domain.
GSC_SITE_URL=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# "mock" = seeded fake data, no API key needed, $0. (Default.)
# "live" = real data through the local server.
#
# You can run "live" with NO DataForSEO key at all — Site Audit works for free via
# PageSpeed Insights, and Search Console is free too. Domain Overview, Keyword
# Research, Backlink Analytics, Competitor Gap, and AI Visibility will show a clear
# "key not set" error until you add a DataForSEO key.
VITE_DATA_SOURCE=mock
